{
  "manifest_version": 3,
  "name": "LoginDeck for Salesforce",
  "version": "0.2.0",
  "description": "Connect authenticated Salesforce orgs in Edge or Chrome to LoginDeck desktop.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.my.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://login.salesforce.com/*",
    "https://test.salesforce.com/*",
    "http://127.0.0.1:17321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LoginDeck"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
